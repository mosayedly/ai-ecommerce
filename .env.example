# Copy this file to `.env` and fill in your real values.
# NEVER commit `.env` to git.

# ─────────────────────────────────────────────────────────────
# Django
# ─────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ─────────────────────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────────────────────
DB_NAME=ecommerce_db
DB_USER=ecommerce_user
DB_PASSWORD=replace-with-strong-password
DB_HOST=127.0.0.1
DB_PORT=5432

# ─────────────────────────────────────────────────────────────
# AI Provider — choose ONE: 'deepseek', 'gemini', 'openai', 'groq',
# 'mistral', 'together', 'openrouter', 'ollama', or 'custom'
# ─────────────────────────────────────────────────────────────
# All providers below use the OpenAI-compatible chat API.
# Pick one and set its API key; the app picks it up automatically.
AI_PROVIDER=deepseek

# ── DeepSeek (paid, very cheap) ──────────────────────────────
# https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-replace-with-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=20

# ── Google Gemini (free tier) ────────────────────────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=replace-with-your-gemini-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=20

# ── OpenAI ────────────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-replace-with-your-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=20

# ── Groq (free tier, very fast) ───────────────────────────────
# https://console.groq.com/keys
GROQ_API_KEY=gsk-replace-with-your-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=20

# ── Mistral ───────────────────────────────────────────────────
# https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=replace-with-your-key
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TIMEOUT=20

# ── Together AI ───────────────────────────────────────────────
# https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=replace-with-your-key
TOGETHER_BASE_URL=https://api.together.xyz/v1
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
TOGETHER_TIMEOUT=20

# ── OpenRouter (access to many models) ───────────────────────
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-replace-with-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TIMEOUT=20

# ── Ollama (local, no key needed) ────────────────────────────
# https://ollama.com/  →  ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=60

# ── Custom OpenAI-compatible endpoint ────────────────────────
# For any other provider (self-hosted, corporate, etc.)
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=
CUSTOM_AI_MODEL=
CUSTOM_AI_TIMEOUT=20

# ─────────────────────────────────────────────────────────────
# AI Recommendation Cache
# ─────────────────────────────────────────────────────────────
RECOMMENDATION_TTL_SECONDS=21600
